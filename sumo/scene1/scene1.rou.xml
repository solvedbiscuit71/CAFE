<?xml version="1.0" encoding="UTF-8"?>

<routes xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="http://sumo.dlr.de/xsd/routes_file.xsd">

    <!-- Flow from J0 to J1 (edge E0) -->
    <flow id="flow_E0"
          begin="0"
          end="300"
          perHour="2400"
          from="E0"
          to="E0"
          departLane="random"
          departSpeed="20"/>

    <!-- Flow from J1 to J0 (edge -E0) -->
    <flow id="flow_minusE0"
          begin="0"
          end="300"
          perHour="2400"
          from="-E0"
          to="-E0"
          departLane="random"
          departSpeed="20"/>

</routes>

